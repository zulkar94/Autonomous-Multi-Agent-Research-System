# Copy to .env and fill in. Never commit the real file.

APP_ENV=development
DEBUG=false
# Required outside development. Generate with: openssl rand -base64 48
SECRET_KEY=

# sqlite+aiosqlite:///./data/ars.db  |  postgresql+asyncpg://user:pass@host:5432/ars
DATABASE_URL=sqlite+aiosqlite:///./data/ars.db

# mock keeps the whole pipeline runnable offline with no keys.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

SEARCH_PROVIDER=mock
TAVILY_API_KEY=
BRAVE_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TRUSTED_HOSTS=*

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_RUN_CREATION=10

MAX_SUBQUESTIONS=6
MAX_SOURCES_PER_QUESTION=5
MAX_DEBATE_ROUNDS=3
MAX_CONCURRENT_RUNS=4
RUN_TIMEOUT_SECONDS=900

# Leave false. Enabling it disables the SSRF guard's private-range blocking.
ALLOW_PRIVATE_NETWORK=false
