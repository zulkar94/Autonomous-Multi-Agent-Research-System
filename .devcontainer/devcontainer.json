{
  "name": "Autonomous Research System",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && cd frontend && npm install",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API + console" },
    "5173": { "label": "SPA dev server" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python", "ms-python.mypy-type-checker"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": true
      }
    }
  },
  "remoteEnv": { "PYTHONPATH": "${containerWorkspaceFolder}/backend" }
}
